{
  "manifest_version": 3,
  "name": "Prism - Color Picker & Contrast Checker",
  "version": "1.1.0",
  "description": "Pick any color on a page in HEX, RGB, HSL or OKLCH. Check WCAG contrast, build palettes, export to Tailwind or CSS. 100% local.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Prism - Color Picker",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "commands": {
    "activate-eyedropper": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Activate Prism - Color Picker eyedropper"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
